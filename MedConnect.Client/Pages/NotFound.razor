@page "/not-found"
@using MedConnect.Client.Layout
@layout MainLayout

<div class="max-w-sm rounded-md border border-slate-200 bg-white p-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">404</p>
    <h1 class="mt-1 text-lg font-semibold text-slate-900">Not found</h1>
    <p class="mt-2 text-sm text-slate-600">Sorry, the content you are looking for does not exist.</p>
    <a href="/" class="mt-4 inline-flex min-h-[44px] items-center rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700">Back to Dashboard</a>
</div>
