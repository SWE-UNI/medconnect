@using MedConnect.Client.Services
@inject ThemeService ThemeService
@implements IDisposable

<button type="button"
        @onclick="ToggleThemeAsync"
        title="@(ThemeService.IsDarkMode ? "Switch to Light mode" : "Switch to Dark mode")"
        aria-label="Toggle dark/light theme"
        class="@GetButtonClass()">
    @if (ThemeService.IsDarkMode)
    {
        <!-- Sun icon -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-amber-400">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        @if (ShowLabel)
        {
            <span class="text-xs font-medium text-slate-300">Light Mode</span>
        }
    }
    else
    {
        <!-- Moon icon -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-slate-500">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        @if (ShowLabel)
        {
            <span class="text-xs font-medium text-slate-700">Dark Mode</span>
        }
    }
</button>

@code {
    [Parameter] public string? CustomClass { get; set; }
    [Parameter] public bool ShowLabel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        await ThemeService.InitializeAsync();
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetButtonClass()
    {
        if (!string.IsNullOrEmpty(CustomClass))
            return CustomClass;

        return "flex h-9 w-9 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors focus:outline-none";
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
