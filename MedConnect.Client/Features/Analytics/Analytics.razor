@page "/analytics"
@using MedConnect.Client.Shared
@inject AnalyticsApiClient AnalyticsApi

<PageTitle>Analytics - MedConnect GH</PageTitle>

<AuthorizeView Roles="Admin" Context="_">
    <Authorized>
        <div class="max-w-4xl">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">System analytics</p>
                <button type="button" @onclick="LoadAsync" disabled="@_busy"
                        class="min-h-[38px] rounded-md bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
                    Refresh
                </button>
            </div>

            @if (!_loaded)
            {
                <p class="mt-4 text-sm text-slate-500">Loading…</p>
            }
            else
            {
                <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <StatCard Label="Registered patients" Value="@_summary.TotalPatients" />
                    <StatCard Label="Staff accounts" Value="@_summary.TotalStaff" />
                    <StatCard Label="Facilities" Value="@_summary.TotalFacilities" />
                    <StatCard Label="Visits (last 30 days)" Value="@_summary.VisitsLast30Days" />
                    <StatCard Label="Field visits logged" Value="@_summary.FieldVisitsLogged" />
                    <StatCard Label="Appointments (next 7 days)" Value="@_summary.AppointmentsUpcoming7Days" />
                    <StatCard Label="Prescriptions issued" Value="@_summary.PrescriptionsIssued" />
                    <StatCard Label="Lab results completed" Value="@_summary.LabResultsCompleted" />
                    <StatCard Label="Referrals in progress" Value="@_summary.ReferralsInProgress" />
                </div>

                <div class="mt-4 rounded-md border border-slate-200 bg-white p-4">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Visits per day (last 14 days)</p>
                    @if (_visits.Count == 0)
                    {
                        <p class="mt-3 text-sm text-slate-500">No visits recorded yet.</p>
                    }
                    else
                    {
                        <div class="mt-4 flex items-end gap-1 h-36">
                            @foreach (var day in _visits)
                            {
                                var max = Math.Max(1, _visits.Max(v => v.Count));
                                var height = day.Count == 0 ? 2 : Math.Max(4, (int)((double)day.Count / max * 128));
                                <div class="flex-1 flex flex-col items-center gap-1" title="@day.Date.ToString("d MMM"): @day.Count">
                                    <div class="w-full rounded-t @(day.Count == 0 ? "bg-slate-200" : "bg-blue-600")" style="height:@(height)px"></div>
                                    <span class="text-[9px] text-slate-400">@day.Date.ToString("dd")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private AnalyticsSummaryDto _summary = new(0, 0, 0, 0, 0, 0, 0, 0, 0);
    private List<DailyVisitDto> _visits = [];
    private bool _loaded;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _loaded = false;
        _summary = await AnalyticsApi.GetSummaryAsync();
        _visits = await AnalyticsApi.GetRecentVisitsAsync();
        _loaded = true;
        _busy = false;
    }
}
