@page "/dashboard"
@using MedConnect.Client.Features.Appointments
@using MedConnect.Client.Features.Patients
@using MedConnect.Client.Features.Referrals
@using MedConnect.Client.Features.Visits
@using MedConnect.Client.Features.Vitals
@inject PatientsApiClient PatientsApi
@inject VisitsApiClient VisitsApi
@inject VitalsApiClient VitalsApi
@inject ReferralsApiClient ReferralsApi
@inject AppointmentsApiClient AppointmentsApi

<PageTitle>Dashboard · MedConnect</PageTitle>

<AuthorizeView Roles="CHW,Doctor,Nurse,FacilityAdmin,Admin">
    <Authorized>
        <div class="max-w-6xl">
            <div class="flex items-center justify-end gap-3">
                <div class="relative w-40 sm:w-64">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
                    </svg>
                    <input @bind="SearchTerm" @bind:event="oninput" placeholder="Search patients"
                           class="w-full rounded-md border border-slate-300 bg-white pl-8 pr-3 py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-slate-300" />
                </div>
            </div>

            @if (Loading)
            {
                <p class="mt-3 text-sm text-slate-500">Loading patients…</p>
            }
            else if (FilteredPatients.Count == 0)
            {
                <p class="mt-3 text-sm text-slate-500">No patients found.</p>
            }
            else
            {
                <div class="mt-3 flex gap-2 overflow-x-auto pb-1">
                    @foreach (var p in FilteredPatients)
                    {
                        var isSelected = Selected?.PatientId == p.PatientId;
                        <button @onclick="() => SelectPatientAsync(p)"
                                class="shrink-0 rounded-md border px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors @(isSelected ? "border-blue-600 bg-blue-600 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300")">
                            @p.FullName
                        </button>
                    }
                </div>
            }

            <div class="mt-4 lg:flex lg:items-start lg:gap-4">

                @* ---------- Patient summary + EHR timeline ---------- *@
                <main class="flex-1 min-w-0 space-y-4">
                        @if (Selected is null)
                        {
                            <div class="rounded-md border border-slate-200 bg-white p-6 text-sm text-slate-500">
                                Select a patient to view their record.
                            </div>
                        }
                        else
                        {
                            <section id="patient" class="rounded-md border border-slate-200 bg-white p-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <h2 class="text-lg font-semibold tracking-tight">@Selected.FullName</h2>
                                        <p class="text-sm text-slate-500 mt-0.5">NHIS @Selected.NHISNumber · @Selected.ContactInfo</p>
                                    </div>
                                    <span class="shrink-0 rounded-md bg-slate-100 border border-slate-200 px-2 py-1 text-xs font-semibold uppercase tracking-wider text-slate-600">
                                        @(Selected.BloodType ?? "Blood type —")
                                    </span>
                                </div>
                                <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-slate-100 pt-3">
                                    <div>
                                        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Age</dt>
                                        <dd class="text-sm font-medium mt-0.5">@AgeOf(Selected.DateOfBirth) yrs</dd>
                                    </div>
                                    <div>
                                        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Date of birth</dt>
                                        <dd class="text-sm font-medium mt-0.5">@Selected.DateOfBirth.ToString("MMM d, yyyy")</dd>
                                    </div>
                                    <div>
                                        <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Patient ID</dt>
                                        <dd class="text-sm font-medium mt-0.5">#@Selected.PatientId</dd>
                                    </div>
                                </dl>
                            </section>

                            @* Vitals + Critical actions, stacked here on mobile only *@
                            <div class="lg:hidden space-y-4">
                                @VitalsPanel
                                @ActionsPanel
                            </div>

                            <section id="timeline" class="rounded-md border border-slate-200 bg-white p-4">
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">EHR Timeline</p>
                                @if (LoadingPatientData)
                                {
                                    <p class="mt-3 text-sm text-slate-500">Loading record…</p>
                                }
                                else if (Visits.Count == 0)
                                {
                                    <p class="mt-3 text-sm text-slate-500">No visits recorded.</p>
                                }
                                else
                                {
                                    <ol class="mt-3 space-y-4 border-l-2 border-slate-200 pl-4">
                                        @foreach (var v in Visits)
                                        {
                                            <li class="relative">
                                                <span class="absolute -left-[21px] top-1 h-2.5 w-2.5 rounded-full bg-blue-600 ring-4 ring-white"></span>
                                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">@v.Date.ToString("MMM d, yyyy")</p>
                                                <p class="text-sm font-medium mt-0.5">@v.Diagnosis</p>
                                                <p class="text-sm text-slate-500">@v.FacilityName@(v.PrescriptionRef is null ? "" : $" · Rx {v.PrescriptionRef}")</p>
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>
                        }
                </main>

                @* ---------- Desktop right rail: vitals + critical actions ---------- *@
                @if (Selected is not null)
                {
                    <aside class="hidden lg:block lg:w-80 lg:shrink-0 space-y-4">
                        @VitalsPanel
                        @ActionsPanel
                    </aside>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="max-w-sm rounded-md border border-slate-200 bg-white p-6 text-center">
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Restricted</p>
            <p class="mt-2 text-sm text-slate-600">This dashboard is available to clinical staff (CHW, Doctor, Nurse, Facility Admin, Admin) only. Sign in with a clinical account to continue.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PatientDto> Patients = [];
    private PatientDto? Selected;
    private List<VisitDto> Visits = [];
    private List<VitalSignDto> Vitals = [];
    private List<ReferralDto> Referrals = [];
    private List<AppointmentDto> Appointments = [];

    private bool Loading = true;
    private bool LoadingPatientData;
    private string SearchTerm = "";
    private string? ActionError;

    private bool ShowVitalForm;
    private int DraftHeartRate = 72;
    private int DraftSystolic = 120;
    private int DraftDiastolic = 80;
    private double? DraftTemperature;
    private int? DraftOxygenSaturation;
    private string? VitalFormError;

    private List<PatientDto> FilteredPatients =>
        string.IsNullOrWhiteSpace(SearchTerm)
            ? Patients
            : Patients.Where(p => p.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        Patients = await PatientsApi.GetAllAsync();
        Loading = false;

        if (Patients.Count > 0)
        {
            await SelectPatientAsync(Patients[0]);
        }
    }

    private async Task SelectPatientAsync(PatientDto patient)
    {
        Selected = patient;
        LoadingPatientData = true;
        ActionError = null;
        ShowVitalForm = false;
        StateHasChanged();

        var visitsTask = VisitsApi.GetByPatientAsync(patient.PatientId);
        var vitalsTask = VitalsApi.GetByPatientAsync(patient.PatientId);
        var referralsTask = ReferralsApi.GetByPatientAsync(patient.PatientId);
        var appointmentsTask = AppointmentsApi.GetByPatientAsync(patient.PatientId);
        await Task.WhenAll(visitsTask, vitalsTask, referralsTask, appointmentsTask);

        Visits = visitsTask.Result;
        Vitals = vitalsTask.Result;
        Referrals = referralsTask.Result;
        Appointments = (await appointmentsTask).Items;
        LoadingPatientData = false;
    }

    private VitalSignDto? LatestVital => Vitals.OrderByDescending(v => v.RecordedAt).FirstOrDefault();

    private IEnumerable<ReferralDto> PendingReferrals => Referrals.Where(r => r.Status == 0);

    private IEnumerable<AppointmentDto> UpcomingAppointments =>
        Appointments.Where(a => a.Status == 0 && a.ScheduledTime >= DateTime.UtcNow.AddDays(-1))
            .OrderBy(a => a.ScheduledTime);

    private int ActionCount => PendingReferrals.Count() + UpcomingAppointments.Count();

    private static int AgeOf(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age))
        {
            age--;
        }
        return age;
    }

    private static (string Label, string Classes) AlertMeta(int level) => level switch
    {
        2 => ("Critical", "bg-red-50 text-red-700 border-red-200"),
        1 => ("Warning", "bg-amber-50 text-amber-700 border-amber-200"),
        _ => ("Normal", "bg-emerald-50 text-emerald-700 border-emerald-200"),
    };

    private static string ReferralStatusLabel(int status) => status switch
    {
        0 => "Pending",
        1 => "Accepted",
        2 => "In transit",
        3 => "Completed",
        _ => "Cancelled",
    };

    private async Task AcceptReferralAsync(ReferralDto referral)
    {
        ActionError = null;
        var result = await ReferralsApi.UpdateStatusAsync(referral.ReferralId, 1);
        if (!result.Succeeded)
        {
            ActionError = result.Error;
            return;
        }

        if (Selected is not null)
        {
            Referrals = await ReferralsApi.GetByPatientAsync(Selected.PatientId);
        }
    }

    private async Task CompleteAppointmentAsync(AppointmentDto appointment)
    {
        ActionError = null;
        var result = await AppointmentsApi.UpdateStatusAsync(appointment.AppointmentId, 1);
        if (!result.Succeeded)
        {
            ActionError = result.Error;
            return;
        }

        if (Selected is not null)
        {
            Appointments = (await AppointmentsApi.GetByPatientAsync(Selected.PatientId)).Items;
        }
    }

    private async Task SubmitVitalsAsync()
    {
        if (Selected is null)
        {
            return;
        }

        VitalFormError = null;
        var dto = new CreateVitalSignDto(
            Selected.PatientId, DraftHeartRate, DraftSystolic, DraftDiastolic, DraftTemperature, DraftOxygenSaturation);

        var result = await VitalsApi.CreateAsync(dto);
        if (!result.Succeeded)
        {
            VitalFormError = result.Error;
            return;
        }

        Vitals = await VitalsApi.GetByPatientAsync(Selected.PatientId);
        ShowVitalForm = false;
    }

    private RenderFragment VitalsPanel =>
        @<section id="vitals" class="rounded-md border border-slate-200 bg-white p-4">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Live Vitals</p>
                <button @onclick="() => ShowVitalForm = !ShowVitalForm"
                        class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-slate-300">
                    @(ShowVitalForm ? "Cancel" : "+ Record")
                </button>
            </div>

            @if (ShowVitalForm)
            {
                <div class="mt-3 space-y-2 border-t border-slate-100 pt-3">
                    <div class="grid grid-cols-2 gap-2">
                        <label class="text-xs">
                            <span class="text-slate-500">Heart rate (bpm)</span>
                            <input type="number" @bind="DraftHeartRate" class="mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">SpO2 (%)</span>
                            <input type="number" @bind="DraftOxygenSaturation" class="mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">BP systolic</span>
                            <input type="number" @bind="DraftSystolic" class="mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">BP diastolic</span>
                            <input type="number" @bind="DraftDiastolic" class="mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                        </label>
                        <label class="text-xs col-span-2">
                            <span class="text-slate-500">Temperature (°C, optional)</span>
                            <input type="number" step="0.1" @bind="DraftTemperature" class="mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                        </label>
                    </div>
                    @if (VitalFormError is not null)
                    {
                        <p class="text-xs text-red-600">@VitalFormError</p>
                    }
                    <button @onclick="SubmitVitalsAsync"
                            class="w-full min-h-[44px] rounded-md bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
                        Save reading
                    </button>
                </div>
            }
            else if (LatestVital is { } v)
            {
                var meta = AlertMeta(v.AlertLevel);
                <div class="mt-3 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="rounded-md border px-2 py-0.5 text-xs font-semibold uppercase tracking-wider @meta.Classes">
                            @meta.Label
                        </span>
                        <span class="text-xs text-slate-400">@v.RecordedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div class="rounded-md bg-slate-50 border border-slate-100 p-2 text-center">
                            <p class="text-lg font-semibold tabular-nums">@v.HeartRate</p>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">bpm</p>
                        </div>
                        <div class="rounded-md bg-slate-50 border border-slate-100 p-2 text-center">
                            <p class="text-lg font-semibold tabular-nums">@v.BloodPressureSystolic/@v.BloodPressureDiastolic</p>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">mmHg</p>
                        </div>
                        <div class="rounded-md bg-slate-50 border border-slate-100 p-2 text-center">
                            <p class="text-lg font-semibold tabular-nums">@(v.OxygenSaturation?.ToString() ?? "—")</p>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">SpO2 %</p>
                        </div>
                    </div>
                    <p class="text-xs text-slate-400">Recorded by @v.RecordedByName</p>
                </div>
            }
            else
            {
                <p class="mt-3 text-sm text-slate-500">No vitals recorded yet.</p>
            }
        </section>;

    private RenderFragment ActionsPanel =>
        @<section id="actions" class="rounded-md border border-slate-200 bg-white p-4">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Critical Actions</p>
                @if (ActionCount > 0)
                {
                    <span class="rounded-md bg-red-50 border border-red-200 text-red-700 px-1.5 py-0.5 text-xs font-semibold">@ActionCount</span>
                }
            </div>

            @if (ActionError is not null)
            {
                <p class="mt-2 text-xs text-red-600">@ActionError</p>
            }

            @if (ActionCount == 0)
            {
                <p class="mt-3 text-sm text-slate-500">Nothing pending.</p>
            }
            else
            {
                <ul class="mt-3 space-y-2">
                    @foreach (var r in PendingReferrals)
                    {
                        <li class="rounded-md border border-amber-200 bg-amber-50 p-2.5">
                            <p class="text-sm font-medium">Referral · @r.FromFacilityName → @r.ToFacilityName</p>
                            <p class="text-xs text-slate-500">@ReferralStatusLabel(r.Status) · @r.Timestamp.ToLocalTime().ToString("MMM d, h:mm tt")</p>
                            <button @onclick="() => AcceptReferralAsync(r)"
                                    class="mt-2 w-full min-h-[44px] rounded-md bg-blue-600 text-white text-xs font-semibold hover:bg-blue-700">
                                Accept referral
                            </button>
                        </li>
                    }
                    @foreach (var a in UpcomingAppointments)
                    {
                        <li class="rounded-md border border-slate-200 bg-slate-50 p-2.5">
                            <p class="text-sm font-medium">Appointment · @a.FacilityName</p>
                            <p class="text-xs text-slate-500">@a.ScheduledTime.ToLocalTime().ToString("MMM d, h:mm tt")</p>
                            <button @onclick="() => CompleteAppointmentAsync(a)"
                                    class="mt-2 w-full min-h-[44px] rounded-md border border-slate-300 text-slate-700 text-xs font-semibold hover:border-slate-400">
                                Mark completed
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>;
}
