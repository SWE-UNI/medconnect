@page "/security"
@using MedConnect.Client.Features.Auth.Dtos
@using MedConnect.Client.Shared
@inject AuthApiClient AuthApi

<PageTitle>Security - MedConnect GH</PageTitle>

<AuthorizeView Context="_">
    <Authorized>
        <div class="max-w-3xl">
            <div class="rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Two-factor authentication</p>

                @if (_loading)
                {
                    <p class="mt-3 text-sm text-slate-500">Loading...</p>
                }
                else if (!_enabled && _setup is null)
                {
                    <p class="mt-3 text-sm text-slate-600">
                        Two-factor authentication is currently <span class="font-semibold text-slate-900">off</span>.
                        Enabling it adds a six-digit code from your authenticator app to the sign-in step.
                    </p>
                    <button type="button" @onclick="SetupAsync" disabled="@_busy"
                            class="mt-4 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Set up authenticator
                    </button>
                }
                else if (_setup is not null && !_enabled)
                {
                    <p class="mt-3 text-sm text-slate-600">
                        Add the account to your authenticator app (e.g. Google Authenticator) using the details below,
                        then enter its current code to confirm.
                    </p>
                    <div class="mt-3 rounded-md bg-slate-50 border border-slate-200 p-3">
                        @if (_qrDataUrl is not null)
                        {
                            <p class="text-xs text-slate-500">Scan with your authenticator app</p>
                            <img id="qr" src="@_qrDataUrl" alt="Two-factor QR code" class="mt-2 h-48 w-48" />
                        }
                        <p class="text-xs text-slate-500 mt-2">Manual entry secret (fallback)</p>
                        <code id="secret" class="mt-1 block text-sm font-mono text-slate-800 break-all">@_setup.Secret</code>
                    </div>
                    <label class="mt-3 block text-xs">
                        <span class="text-slate-500 font-medium">Current code</span>
                        <input type="text" id="enableCode" @bind="_enableCode" @bind:event="oninput" inputmode="numeric" placeholder="e.g. 123456" class="@FieldClass" />
                    </label>
                    @if (_error is not null)
                    {
                        <p class="mt-2 text-xs text-red-600">@_error</p>
                    }
                    <button type="button" @onclick="EnableAsync" disabled="@_busy"
                            class="mt-3 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Enable two-factor
                    </button>
                }
                else
                {
                    <p class="mt-3 text-sm text-slate-600">
                        Two-factor authentication is currently <span class="font-semibold text-green-700">on</span>.
                    </p>
                    <label class="mt-3 block text-xs">
                        <span class="text-slate-500 font-medium">Current code to turn it off</span>
                        <input type="text" id="disableCode" @bind="_disableCode" @bind:event="oninput" inputmode="numeric" placeholder="e.g. 123456" class="@FieldClass" />
                    </label>
                    @if (_error is not null)
                    {
                        <p class="mt-2 text-xs text-red-600">@_error</p>
                    }
                    <button type="button" @onclick="DisableAsync" disabled="@_busy"
                            class="mt-3 min-h-[44px] rounded-md bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
                        Turn off two-factor
                    </button>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private bool _loading = true;
    private bool _enabled;
    private TwoFactorSetupDto? _setup;
    private string? _qrDataUrl;
    private string _enableCode = "";
    private string _disableCode = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var status = await AuthApi.StatusTwoFactorAsync();
        _enabled = status.Succeeded && status.Value;
        _loading = false;
    }

    private async Task SetupAsync()
    {
        _busy = true;
        _error = null;
        var result = await AuthApi.SetupTwoFactorAsync();
        if (result.Succeeded)
        {
            _setup = result.Value;
            _enabled = result.Value!.Enabled;
            _qrDataUrl = result.Value.OtpauthUri is { Length: > 0 }
                ? QrImage.ToDataUrl(result.Value.OtpauthUri)
                : null;
        }
        else
        {
            _error = result.Error;
        }
        _busy = false;
    }

    private async Task EnableAsync()
    {
        _busy = true;
        _error = null;
        var result = await AuthApi.EnableTwoFactorAsync(_enableCode);
        if (result.Succeeded)
        {
            _enabled = true;
            _setup = null;
            _enableCode = "";
        }
        else
        {
            _error = result.Error;
        }
        _busy = false;
    }

    private async Task DisableAsync()
    {
        _busy = true;
        _error = null;
        var result = await AuthApi.DisableTwoFactorAsync(_disableCode);
        if (result.Succeeded)
        {
            _enabled = false;
            _disableCode = "";
        }
        else
        {
            _error = result.Error;
        }
        _busy = false;
    }
}