@page "/forgot-password"
@layout MedConnect.Client.Shared.AuthLayout
@using System.ComponentModel.DataAnnotations
@using MedConnect.Client.Features.Auth.Dtos
@using MedConnect.Client.Shared
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>Reset Password - MedConnect GH</PageTitle>

<div class="h-screen w-full flex flex-col md:flex-row md:overflow-hidden bg-white relative">
    <div class="absolute top-4 right-4 z-50">
        <ThemeToggle CustomClass="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors shadow-sm focus:outline-none" />
    </div>
    <!-- Left Section: Branding & Highlights -->
    <div class="hidden md:flex md:w-1/2 flex-col bg-blue-600 text-white px-10 py-6 md:overflow-y-auto">
        <div class="max-w-xl mx-auto my-auto w-full py-4">
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-1 text-center md:text-left">
                MedConnect
            </h1>
            <p class="text-blue-100 text-base font-medium mb-6 text-center md:text-left">
                Connected Healthcare & Patient Management
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Item 1 -->
                <div class="flex flex-col items-start p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition duration-150 ease-in-out">
                    <div class="h-8 w-8 rounded-md bg-white/15 flex items-center justify-center mb-2">
                        <svg class="h-[18px] w-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <h4 class="font-semibold text-sm text-white">Account Recovery</h4>
                    <p class="text-blue-100 text-[11px] mt-1 leading-relaxed">Secure verification to restore access to your medical records.</p>
                </div>

                <!-- Item 2 -->
                <div class="flex flex-col items-start p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition duration-150 ease-in-out">
                    <div class="h-8 w-8 rounded-md bg-white/15 flex items-center justify-center mb-2">
                        <svg class="h-[18px] w-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <h4 class="font-semibold text-sm text-white">Identity Verification</h4>
                    <p class="text-blue-100 text-[11px] mt-1 leading-relaxed">Cross-referenced with Ghana Health Service NHIS credentials.</p>
                </div>

                <!-- Item 3 -->
                <div class="flex flex-col items-start p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition duration-150 ease-in-out">
                    <div class="h-8 w-8 rounded-md bg-white/15 flex items-center justify-center mb-2">
                        <svg class="h-[18px] w-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <h4 class="font-semibold text-sm text-white">Facility Assistance</h4>
                    <p class="text-blue-100 text-[11px] mt-1 leading-relaxed">Direct support available on-site through facility IT desks.</p>
                </div>

                <!-- Item 4 -->
                <div class="flex flex-col items-start p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition duration-150 ease-in-out">
                    <div class="h-8 w-8 rounded-md bg-white/15 flex items-center justify-center mb-2">
                        <svg class="h-[18px] w-[18px] text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h4 class="font-semibold text-sm text-white">Audit & Monitoring</h4>
                    <p class="text-blue-100 text-[11px] mt-1 leading-relaxed">All password resets and security updates are permanently logged.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Section: Recovery Form -->
    <div class="w-full md:w-1/2 flex items-center justify-center bg-white px-8 py-16 md:px-16 md:overflow-y-auto">
        <div class="w-full max-w-md">
            <div class="text-center mb-8">
                <!-- Mobile Logo & Brand Header -->
                <div class="flex items-center justify-center gap-2.5 mb-5 md:hidden">
                    <div class="h-9 w-9 shrink-0 rounded-lg bg-blue-600 text-white flex items-center justify-center shadow-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </div>
                    <span class="text-xl font-bold tracking-tight text-blue-600">MedConnect</span>
                </div>

                <h2 class="text-2xl md:text-3xl font-bold text-blue-600 tracking-tight mb-1 md:mb-2">
                    Reset Password
                </h2>
                <p class="text-slate-500 text-sm">
                    Recover access to your MedConnect account
                </p>
            </div>

            @if (_step == RecoveryStep.Completed)
            {
                <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-6 text-center space-y-4">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-emerald-900">Password Reset Successful</h3>
                        <p class="text-xs text-emerald-700 mt-1">Your password has been updated. You can now log in using your new credentials.</p>
                    </div>
                    <a href="/login"
                       class="inline-block w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-3 px-4 rounded-md tracking-wider uppercase transition shadow-sm">
                        Proceed to Sign In
                    </a>
                </div>
            }
            else if (_step == RecoveryStep.SetNewPassword)
            {
                <EditForm Model="_resetModel" OnValidSubmit="HandleResetPasswordAsync" class="space-y-5">
                    <DataAnnotationsValidator />

                    <div class="p-3 bg-blue-50 border border-blue-100 rounded-md text-xs text-blue-800 flex items-start gap-2">
                        <svg class="h-4 w-4 text-blue-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Reset code generated for <strong>@_identifier</strong>. Enter your code and choose a new password.</span>
                    </div>

                    <!-- Token Field -->
                    <div class="relative rounded-md border border-slate-300 focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 bg-[#EDF3FC]">
                        <span class="absolute -top-2.5 left-3 bg-white px-1 text-[11px] text-blue-600 font-semibold tracking-wide">
                            Reset token / code *
                        </span>
                        <InputText id="token" @bind-Value="_resetModel.Token" placeholder="Paste reset code here"
                                   class="w-full bg-transparent text-slate-800 text-sm focus:outline-none px-3.5 py-3" />
                    </div>
                    <ValidationMessage For="() => _resetModel.Token" class="text-xs text-red-600" />

                    <!-- New Password -->
                    <div class="relative rounded-md border border-slate-300 focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 bg-[#EDF3FC]">
                        <span class="absolute -top-2.5 left-3 bg-white px-1 text-[11px] text-slate-500 font-semibold tracking-wide focus-within:text-blue-600">
                            New password *
                        </span>
                        <InputText id="new-password" type="password" @bind-Value="_resetModel.NewPassword" placeholder="Minimum 6 characters"
                                   class="w-full bg-transparent text-slate-800 text-sm focus:outline-none px-3.5 py-3" />
                    </div>
                    <ValidationMessage For="() => _resetModel.NewPassword" class="text-xs text-red-600" />

                    <!-- Confirm Password -->
                    <div class="relative rounded-md border border-slate-300 focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 bg-[#EDF3FC]">
                        <span class="absolute -top-2.5 left-3 bg-white px-1 text-[11px] text-slate-500 font-semibold tracking-wide focus-within:text-blue-600">
                            Confirm new password *
                        </span>
                        <InputText id="confirm-password" type="password" @bind-Value="_resetModel.ConfirmPassword" placeholder="Re-enter new password"
                                   class="w-full bg-transparent text-slate-800 text-sm focus:outline-none px-3.5 py-3" />
                    </div>
                    <ValidationMessage For="() => _resetModel.ConfirmPassword" class="text-xs text-red-600" />

                    @if (_error is not null)
                    {
                        <div class="text-xs text-red-600 font-medium bg-red-50 p-2.5 rounded border border-red-200">
                            @_error
                        </div>
                    }

                    <div class="space-y-3 pt-2">
                        <button type="submit" disabled="@_busy"
                                class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-3 px-4 rounded-md tracking-wider uppercase transition duration-150 ease-in-out disabled:opacity-50 shadow-sm">
                            @(_busy ? "UPDATING PASSWORD..." : "UPDATE PASSWORD")
                        </button>
                        <button type="button" @onclick="() => _step = RecoveryStep.Request"
                                class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2.5 px-4 rounded-md transition">
                            Back to Identifier Entry
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="_requestModel" OnValidSubmit="HandleRequestResetAsync" class="space-y-6">
                    <DataAnnotationsValidator />

                    <!-- Email / NHIS Field -->
                    <div class="relative rounded-md border border-slate-300 focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 bg-[#EDF3FC]">
                        <span class="absolute -top-2.5 left-3 bg-white px-1 text-[11px] text-blue-600 font-semibold tracking-wide">
                            Email or NHIS number *
                        </span>
                        <InputText id="identifier" @bind-Value="_requestModel.Identifier" placeholder="admin@medconnect.gh or 1234567890"
                                   class="w-full bg-transparent text-slate-800 text-sm focus:outline-none px-3.5 py-3" />
                    </div>
                    <ValidationMessage For="() => _requestModel.Identifier" class="text-xs text-red-600" />

                    @if (_infoMessage is not null)
                    {
                        <div class="p-3 bg-blue-50 border border-blue-200 rounded-md text-xs text-blue-800 space-y-1">
                            <p class="font-semibold">@_infoMessage</p>
                            @if (_directSupportGuidance)
                            {
                                <p class="text-slate-600 mt-1">
                                    For security and facility policy compliance, staff and patients may also contact their local facility IT administrator or email support directly:
                                </p>
                                <div class="pt-1">
                                    <a href="mailto:support@medconnect.gh?subject=MedConnect%20Password%20Reset%20Request%20-%20@_identifier&body=Hello%20MedConnect%20Support%2C%0A%0APlease%20assist%20me%20with%20resetting%20my%20password%20for%20account%20identifier%3A%20@_identifier."
                                       class="inline-flex items-center gap-1.5 font-bold text-blue-600 hover:underline">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                        </svg>
                                        support@medconnect.gh
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    @if (_error is not null)
                    {
                        <div class="text-xs text-red-600 font-medium bg-red-50 p-2.5 rounded border border-red-200">
                            @_error
                        </div>
                    }

                    <div>
                        <button type="submit" disabled="@_busy"
                                class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-3 px-4 rounded-md tracking-wider uppercase transition duration-150 ease-in-out disabled:opacity-50 shadow-sm">
                            @(_busy ? "VERIFYING ACCOUNT..." : "CONTINUE")
                        </button>
                    </div>
                </EditForm>
            }

            <!-- Links -->
            <div class="mt-8 text-center space-y-3">
                <div>
                    <a href="/login" class="text-sm font-semibold text-blue-600 hover:underline inline-flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to sign in
                    </a>
                </div>
                <div class="text-xs text-slate-500">
                    Don't have an account? 
                    <a href="/register" class="font-bold text-blue-600 hover:underline">
                        Register
                    </a>
                </div>
                <div class="pt-4 border-t border-slate-100 text-xs text-slate-500 flex items-center justify-center gap-1.5 flex-wrap">
                    <svg class="h-3.5 w-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>Need help? Contact support:</span>
                    <a href="mailto:support@medconnect.gh?subject=MedConnect%20Password%20Reset%20Assistance"
                       class="font-semibold text-blue-600 hover:underline">
                        support@medconnect.gh
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private enum RecoveryStep
    {
        Request,
        SetNewPassword,
        Completed
    }

    private RecoveryStep _step = RecoveryStep.Request;
    private readonly RequestResetFormModel _requestModel = new();
    private readonly ResetPasswordFormModel _resetModel = new();
    private string? _identifier;
    private string? _error;
    private string? _infoMessage;
    private bool _directSupportGuidance;
    private bool _busy;

    private async Task HandleRequestResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_requestModel.Identifier))
            return;

        _busy = true;
        _error = null;
        _infoMessage = null;
        _directSupportGuidance = false;

        _identifier = _requestModel.Identifier.Trim();

        try
        {
            var result = await AuthApi.ForgotPasswordAsync(new ForgotPasswordDto(_identifier));
            if (result.Succeeded && result.Value is not null)
            {
                if (!string.IsNullOrEmpty(result.Value.ResetToken))
                {
                    _resetModel.Token = result.Value.ResetToken;
                    _step = RecoveryStep.SetNewPassword;
                }
                else
                {
                    _infoMessage = result.Value.Message;
                    _directSupportGuidance = true;
                }
            }
            else
            {
                // Graceful fallback for offline / remote hosting transition
                _infoMessage = $"Password reset request received for {_identifier}.";
                _directSupportGuidance = true;
            }
        }
        catch
        {
            _infoMessage = $"Password reset request received for {_identifier}.";
            _directSupportGuidance = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleResetPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_resetModel.NewPassword) || string.IsNullOrWhiteSpace(_resetModel.Token))
            return;

        if (_resetModel.NewPassword != _resetModel.ConfirmPassword)
        {
            _error = "The password confirmation does not match.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await AuthApi.ResetPasswordAsync(new ResetPasswordDto(
                _identifier ?? _requestModel.Identifier.Trim(),
                _resetModel.Token.Trim(),
                _resetModel.NewPassword));

            if (result.Succeeded)
            {
                _step = RecoveryStep.Completed;
            }
            else
            {
                _error = result.Error ?? "Unable to reset password. The reset token may be invalid or expired.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to reset password: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class RequestResetFormModel
    {
        [Required(ErrorMessage = "Email or NHIS number is required")]
        public string Identifier { get; set; } = "";
    }

    private class ResetPasswordFormModel
    {
        [Required(ErrorMessage = "Reset token is required")]
        public string Token { get; set; } = "";

        [Required(ErrorMessage = "New password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password")]
        public string ConfirmPassword { get; set; } = "";
    }
}
