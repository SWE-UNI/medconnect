@page "/register"
@layout MedConnect.Client.Shared.AuthLayout
@using System.ComponentModel.DataAnnotations
@using MedConnect.Client.Features.Auth.Dtos
@using MedConnect.Client.Shared
@inject AuthApiClient AuthApi
@inject TokenStorage TokenStorage
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Register - MedConnect GH</PageTitle>

<div class="min-h-screen bg-slate-50 w-full flex items-center justify-center p-6 relative">
    <div class="absolute top-4 right-4 z-50">
        <ThemeToggle CustomClass="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors shadow-sm focus:outline-none" />
    </div>
    <div class="w-full max-w-sm">
        <div class="rounded-md border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-2">
            <div class="h-7 w-7 shrink-0 rounded-md bg-blue-600 text-white flex items-center justify-center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12 5v14M5 12h14" /></svg>
            </div>
            <span class="text-sm font-semibold tracking-tight text-slate-900">MedConnect GH</span>
        </div>
        <p class="mt-1 mb-5 text-sm text-slate-500">Register a patient account</p>

        <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" class="space-y-3">
            <DataAnnotationsValidator />
            <label class="block text-xs">
                <span class="text-slate-500">Full name</span>
                <InputText id="fullName" @bind-Value="_model.FullName" class="@FieldClass" />
                <ValidationMessage For="() => _model.FullName" class="mt-1 block text-xs text-red-600" />
            </label>
            <label class="block text-xs">
                <span class="text-slate-500">Email</span>
                <InputText id="email" @bind-Value="_model.Email" class="@FieldClass" />
                <ValidationMessage For="() => _model.Email" class="mt-1 block text-xs text-red-600" />
            </label>
            <label class="block text-xs">
                <span class="text-slate-500">Password</span>
                <InputText id="password" type="password" @bind-Value="_model.Password" class="@FieldClass" />
                <ValidationMessage For="() => _model.Password" class="mt-1 block text-xs text-red-600" />
            </label>
            <label class="block text-xs">
                <span class="text-slate-500">NHIS Number</span>
                <InputText id="nhis" @bind-Value="_model.NHISNumber" class="@FieldClass" />
                <ValidationMessage For="() => _model.NHISNumber" class="mt-1 block text-xs text-red-600" />
            </label>
            <label class="block text-xs">
                <span class="text-slate-500">Date of birth</span>
                <InputDate id="dob" @bind-Value="_model.DateOfBirth" class="@FieldClass" />
                <ValidationMessage For="() => _model.DateOfBirth" class="mt-1 block text-xs text-red-600" />
            </label>
            <label class="block text-xs">
                <span class="text-slate-500">Contact info</span>
                <InputText id="contact" @bind-Value="_model.ContactInfo" placeholder="Phone number" class="@FieldClass" />
                <ValidationMessage For="() => _model.ContactInfo" class="mt-1 block text-xs text-red-600" />
            </label>

            @if (_error is not null)
            {
                <p class="text-xs text-red-600">@_error</p>
            }

            <button type="submit" disabled="@_busy"
                    class="w-full min-h-[44px] rounded-md bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50">
                @(_busy ? "Creating account..." : "Create account")
            </button>
        </EditForm>

        <p class="mt-4 text-center text-xs text-slate-500">Already have an account? <a href="/login" class="font-medium text-blue-600 hover:text-blue-700">Sign in</a></p>
        </div>
    </div>
</div>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private readonly RegisterFormModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task HandleRegisterAsync()
    {
        _busy = true;
        _error = null;

        var dto = new RegisterDto(
            _model.Email,
            _model.Password,
            _model.FullName,
            _model.NHISNumber,
            _model.DateOfBirth.HasValue ? DateOnly.FromDateTime(_model.DateOfBirth.Value) : null,
            _model.ContactInfo);

        var result = await AuthApi.RegisterAsync(dto);
        if (result.Succeeded)
        {
            await TokenStorage.SetTokenAsync(result.Value!.Token);
            AuthStateProvider.NotifyUserAuthenticated(result.Value.Token);
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = result.Error;
            _busy = false;
        }
    }

    private class RegisterFormModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "NHIS number is required.")]
        public string NHISNumber { get; set; } = "";

        [Required(ErrorMessage = "Date of birth is required.")]
        public DateTime? DateOfBirth { get; set; }

        [Required(ErrorMessage = "Contact info is required.")]
        public string ContactInfo { get; set; } = "";
    }
}