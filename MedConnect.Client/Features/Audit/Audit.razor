@page "/audit"
@using MedConnect.Client.Shared
@inject AuditApiClient AuditApi

<PageTitle>Audit Log - MedConnect GH</PageTitle>

<AuthorizeView Roles="Admin" Context="_">
    <Authorized>
        <div class="max-w-4xl">
            <div class="rounded-md border border-slate-200 bg-white p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Audit log</p>
                    <div class="flex items-center gap-2">
                        <select @bind="_entityType" @bind:after="LoadAsync" class="min-h-[38px] rounded-md border border-slate-300 px-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30">
                            <option value="">All entity types</option>
                            <option value="User">User</option>
                            <option value="Patient">Patient</option>
                            <option value="Appointment">Appointment</option>
                            <option value="Prescription">Prescription</option>
                            <option value="Referral">Referral</option>
                            <option value="LabResult">LabResult</option>
                        </select>
                        <button type="button" @onclick="LoadAsync" disabled="@_busy"
                                class="min-h-[38px] rounded-md bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
                            Refresh
                        </button>
                    </div>
                </div>
                <p class="mt-1 text-xs text-slate-500">Most recent @_entries.Count of a possible 200 rows. Filter by entity type above.</p>

                <div class="mt-3 flex flex-col gap-2">
                    @if (_loaded && _entries.Count == 0)
                    {
                        <p class="text-sm text-slate-500">No audit entries match.</p>
                    }

                    @foreach (var e in _entries)
                    {
                        <div class="rounded-md border border-slate-200 p-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="text-[10px] rounded-md px-1.5 py-0.5 font-semibold @ActionBadge(e.Action)">@e.Action</span>
                                <span class="text-xs text-slate-500">@e.PerformedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</span>
                            </div>
                            <p class="mt-2 text-sm text-slate-900 font-medium">@(e.ActorEmail ?? "system")</p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @if (!string.IsNullOrEmpty(e.EntityType))
                                {
                                    <text>@e.EntityType</text>
                                    if (!string.IsNullOrEmpty(e.EntityId))
                                    {
                                        <text> #@e.EntityId</text>
                                    }
                                    <text> · </text>
                                }
                                @if (string.IsNullOrEmpty(e.Details))
                                {
                                    <text>@e.Action</text>
                                }
                                else
                                {
                                    <text>@e.Details</text>
                                }
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _entityType = "";
    private List<AuditLogEntryDto> _entries = [];
    private bool _loaded;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _loaded = false;
        _entries = await AuditApi.GetAsync(string.IsNullOrWhiteSpace(_entityType) ? null : _entityType);
        _loaded = true;
        _busy = false;
    }

    private static string ActionBadge(string action) =>
        action.StartsWith("Login") || action.StartsWith("TwoFactor") ? "bg-blue-50 text-blue-700 border border-blue-200"
        : action.EndsWith("Failed") || action.EndsWith("Blocked") ? "bg-red-50 text-red-700 border border-red-200"
        : "bg-green-50 text-green-700 border border-green-200";
}
