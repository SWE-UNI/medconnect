@page "/prescriptions"
@using MedConnect.Client.Shared
@inject PrescriptionsApiClient PrescriptionsApi

<PageTitle>Prescriptions - MedConnect GH</PageTitle>

<AuthorizeView Roles="CHW,Doctor,Nurse,FacilityAdmin,Admin" Context="_">
    <Authorized>
        <div class="max-w-3xl">
            <div class="rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Write a prescription</p>
                <EditForm Model="_model" OnValidSubmit="HandleCreateAsync" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <label class="text-xs">
                        <span class="text-slate-500">Patient ID</span>
                        <InputNumber id="patientId" @bind-Value="_model.PatientId" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Visit ID</span>
                        <InputNumber id="visitId" @bind-Value="_model.VisitId" class="@FieldClass" />
                    </label>
                    <label class="text-xs sm:col-span-2">
                        <span class="text-slate-500">Medication</span>
                        <InputText id="medication" @bind-Value="_model.Medication" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Dosage (optional)</span>
                        <InputText id="dosage" @bind-Value="_model.Dosage" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Frequency (optional)</span>
                        <InputText id="frequency" @bind-Value="_model.Frequency" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Duration (days, optional)</span>
                        <InputNumber id="durationDays" @bind-Value="_model.DurationDays" class="@FieldClass" />
                    </label>
                    <label class="text-xs sm:col-span-2">
                        <span class="text-slate-500">Instructions (optional)</span>
                        <InputTextArea id="instructions" @bind-Value="_model.Instructions" rows="2" class="@FieldClass" />
                    </label>

                    @if (_error is not null)
                    {
                        <p class="text-xs text-red-600 sm:col-span-2">@_error</p>
                    }

                    <button type="submit" disabled="@_busy"
                            class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Save prescription
                    </button>
                </EditForm>
            </div>

            <div class="mt-4 rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Patient prescriptions</p>
                <div class="mt-3 flex items-end gap-3">
                    <label class="text-xs flex-1">
                        <span class="text-slate-500">Patient ID</span>
                        <InputNumber id="searchPatientId" @bind-Value="_searchPatientId" class="@FieldClass" />
                    </label>
                    <button type="button" @onclick="LoadAsync" disabled="@_busy"
                            class="min-h-[44px] rounded-md bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
                        Load
                    </button>
                </div>

                @if (_loaded && _list.Count == 0)
                {
                    <p class="mt-4 text-sm text-slate-500">No prescriptions for this patient yet.</p>
                }

                <div class="mt-3 flex flex-col gap-2">
                    @foreach (var p in _list)
                    {
                        <div class="rounded-md border border-slate-200 p-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="text-sm font-semibold text-slate-900">@p.Medication</span>
                                <span class="text-xs text-slate-500">@p.PrescribedAt.ToString("d MMM yyyy") · @p.PrescribedByUserName</span>
                            </div>
                            <p class="mt-1 text-xs text-slate-600">
                                @p.Dosage@(string.IsNullOrEmpty(p.Frequency) ? "" : $" — {p.Frequency}")@(p.DurationDays.HasValue ? $" for {p.DurationDays} days" : "")
                            </p>
                            @if (!string.IsNullOrEmpty(p.Instructions))
                            {
                                <p class="mt-1 text-xs text-slate-500">@p.Instructions</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private List<PrescriptionDto> _list = [];
    private readonly NewPrescriptionModel _model = new();
    private int? _searchPatientId;
    private bool _loaded;
    private string? _error;
    private bool _busy;

    private async Task LoadAsync()
    {
        _busy = true;
        _loaded = false;
        _list = _searchPatientId.HasValue ? await PrescriptionsApi.GetByPatientAsync(_searchPatientId.Value) : [];
        _loaded = true;
        _busy = false;
    }

    private async Task HandleCreateAsync()
    {
        _busy = true;
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Medication))
        {
            _error = "Medication name is required.";
            _busy = false;
            return;
        }

        var result = await PrescriptionsApi.CreateAsync(new CreatePrescriptionDto(
            _model.PatientId, _model.VisitId, _model.Medication, _model.Dosage,
            _model.Frequency, _model.DurationDays, _model.Instructions));

        if (result.Succeeded)
        {
            _model.Medication = "";
            _model.Dosage = null;
            _model.Frequency = null;
            _model.DurationDays = null;
            _model.Instructions = null;
            _searchPatientId = _model.PatientId;
            await LoadAsync();
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private class NewPrescriptionModel
    {
        public int PatientId { get; set; }
        public int VisitId { get; set; }
        public string Medication { get; set; } = "";
        public string? Dosage { get; set; }
        public string? Frequency { get; set; }
        public int? DurationDays { get; set; }
        public string? Instructions { get; set; }
    }
}