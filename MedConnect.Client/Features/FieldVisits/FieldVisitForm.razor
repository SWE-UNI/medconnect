@page "/field-visits"
@using MedConnect.Client.Shared
@inject FieldVisitsApiClient FieldVisitsApi

<PageTitle>Field Visits - MedConnect GH</PageTitle>

<AuthorizeView Roles="CHW" Context="_">
    <Authorized>
        <div class="max-w-3xl">
            <div class="rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">New field visit log</p>
                <EditForm Model="_model" OnValidSubmit="HandleCreateAsync" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <label class="text-xs">
                        <span class="text-slate-500">Patient ID (optional)</span>
                        <InputNumber id="patientId" @bind-Value="_model.PatientId" class="@FieldClass" />
                    </label>
                    <label class="text-xs sm:col-span-2">
                        <span class="text-slate-500">Household data</span>
                        <InputTextArea id="household" @bind-Value="_model.HouseholdData" rows="4" class="@TextAreaClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Latitude (optional)</span>
                        <InputNumber id="lat" @bind-Value="_model.Latitude" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Longitude (optional)</span>
                        <InputNumber id="lng" @bind-Value="_model.Longitude" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Visit date</span>
                        <InputDate id="visitDate" @bind-Value="_model.VisitDate" class="@FieldClass" />
                    </label>

                    <div class="sm:col-span-2 mt-1 rounded-md bg-slate-50 p-3">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Maternal &amp; child health (optional)</p>
                        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="text-xs">
                                <span class="text-slate-500">Pregnancy status</span>
                                <select id="pregnancyStatus" @bind="_model.PregnancyStatusProxy" class="@FieldClass">
                                    <option value="">Not specified</option>
                                    <option value="1">Not pregnant</option>
                                    <option value="2">Pregnant</option>
                                    <option value="3">Postpartum</option>
                                </select>
                            </label>
                            <label class="text-xs">
                                <span class="text-slate-500">Gestational age (weeks)</span>
                                <InputNumber id="gestationalAge" @bind-Value="_model.GestationalAgeWeeks" class="@FieldClass" />
                            </label>
                            <label class="text-xs">
                                <span class="text-slate-500">Antenatal visits so far</span>
                                <InputNumber id="antenatalVisits" @bind-Value="_model.AntenatalVisits" class="@FieldClass" />
                            </label>
                            <label class="text-xs">
                                <span class="text-slate-500">Child age (months)</span>
                                <InputNumber id="childAgeMonths" @bind-Value="_model.ChildAgeMonths" class="@FieldClass" />
                            </label>
                            <label class="text-xs">
                                <span class="text-slate-500">Child weight (kg)</span>
                                <InputNumber id="childWeight" @bind-Value="_model.ChildWeightKg" class="@FieldClass" />
                            </label>
                            <label class="text-xs flex flex-col justify-end pb-2">
                                <span class="text-slate-500">Immunisations up to date</span>
                                <input id="immunizations" type="checkbox" class="mt-2 h-5 w-5" @bind="_model.ImmunizationsUpToDate" />
                            </label>
                            <label class="text-xs sm:col-span-2">
                                <span class="text-slate-500">Danger signs</span>
                                <InputTextArea id="dangerSigns" @bind-Value="_model.DangerSigns" rows="2" class="@FieldClass" />
                            </label>
                        </div>
                    </div>

                    @if (_error is not null)
                    {
                        <p class="text-xs text-red-600 sm:col-span-2">@_error</p>
                    }

                    <button type="submit" disabled="@_busy"
                            class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Submit log
                    </button>
                </EditForm>
            </div>

            <div class="mt-4">
                <ListCard TItem="FieldVisitLogDto" Title="Your recent visits" Items="_logs" EmptyText="No field visits logged yet.">
                    <RowTemplate Context="log">
                        <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                            <span class="text-xs text-slate-500 sm:w-28">@log.VisitDate.ToString("d MMM yyyy")</span>
                            <span class="text-sm text-slate-700 sm:w-36">@(log.PatientId?.ToString() ?? "Household visit")</span>
                            <span class="text-sm text-slate-900">@log.HouseholdData</span>
                            @if (log.PregnancyStatus is not null || log.ChildWeightKg is not null)
                            {
                                <span class="text-[11px] font-semibold text-blue-600">@PregnancyLabel(log.PregnancyStatus)@(log.ChildWeightKg is not null ? $" • {log.ChildWeightKg} kg" : "")</span>
                            }
                        </div>
                    </RowTemplate>
                </ListCard>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private const string TextAreaClass =
        "mt-1 w-full min-h-[88px] rounded-md border border-slate-300 px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private List<FieldVisitLogDto> _logs = [];
    private readonly NewLogModel _model = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _logs = await FieldVisitsApi.GetMineAsync();
    }

    private async Task HandleCreateAsync()
    {
        _busy = true;
        _error = null;

        var result = await FieldVisitsApi.CreateAsync(new CreateFieldVisitLogDto(
            _model.PatientId, _model.HouseholdData, _model.Latitude, _model.Longitude, _model.VisitDate,
            _model.PregnancyStatus, _model.GestationalAgeWeeks, _model.AntenatalVisits, _model.ChildAgeMonths,
            _model.ChildWeightKg, _model.ImmunizationsUpToDate, _model.DangerSigns));

        if (result.Succeeded)
        {
            _logs.Insert(0, result.Value!);
            _model.Reset();
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private static string? PregnancyLabel(int? status) => status switch
    {
        1 => "Not pregnant",
        2 => "Pregnant",
        3 => "Postpartum",
        _ => null
    };

    private class NewLogModel
    {
        public int? PatientId { get; set; }
        public string HouseholdData { get; set; } = "";
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public DateTime VisitDate { get; set; } = DateTime.Today;
        public string PregnancyStatusProxy { get; set; } = "";
        public int? PregnancyStatus => int.TryParse(PregnancyStatusProxy, out var v) ? v : null;
        public int? GestationalAgeWeeks { get; set; }
        public int? AntenatalVisits { get; set; }
        public int? ChildAgeMonths { get; set; }
        public decimal? ChildWeightKg { get; set; }
        public bool? ImmunizationsUpToDate { get; set; }
        public string DangerSigns { get; set; } = "";

        public void Reset()
        {
            HouseholdData = "";
            Latitude = null;
            Longitude = null;
            PregnancyStatusProxy = "";
            GestationalAgeWeeks = null;
            AntenatalVisits = null;
            ChildAgeMonths = null;
            ChildWeightKg = null;
            ImmunizationsUpToDate = null;
            DangerSigns = "";
        }
    }
}
