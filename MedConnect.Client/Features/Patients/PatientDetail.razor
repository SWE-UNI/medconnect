@page "/patients/{PatientId:int}"
@using MedConnect.Client.Features.Appointments
@using MedConnect.Client.Features.Facilities
@using MedConnect.Client.Features.Referrals
@using MedConnect.Client.Features.Visits
@using MedConnect.Client.Shared
@inject PatientsApiClient PatientsApi
@inject VisitsApiClient VisitsApi
@inject AppointmentsApiClient AppointmentsApi
@inject ReferralsApiClient ReferralsApi
@inject FacilitiesApiClient FacilitiesApi

<PageTitle>Patient - MedConnect GH</PageTitle>

<AuthorizeView Roles="CHW,Doctor,Nurse,FacilityAdmin,Admin" Context="_">
    <Authorized>
        @if (_patient is null)
        {
            <p class="text-sm text-slate-500">Loading...</p>
        }
        else
        {
            <div class="max-w-3xl">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight text-slate-900">@_patient.FullName</h1>
                        <p class="mt-1 text-sm text-slate-500">NHIS @_patient.NHISNumber &middot; DOB @_patient.DateOfBirth.ToString("d MMM yyyy") &middot; @_patient.ContactInfo@(_patient.BloodType is null ? "" : $" · {_patient.BloodType}")</p>
                    </div>
                    <AuthorizeView Roles="Admin" Context="__">
                        <Authorized>
                            <button @onclick="OpenEditModal"
                                    class="shrink-0 min-h-[44px] rounded-md border border-slate-200 px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900">
                                Edit profile
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>

                <Modal Title="Edit patient profile" @bind-Show="_showEditModal">
                    <EditForm Model="_editModel" OnValidSubmit="HandleEditAsync" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="text-xs sm:col-span-2">
                            <span class="text-slate-500">Full name</span>
                            <InputText @bind-Value="_editModel.FullName" class="@FieldClass" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">NHIS Number</span>
                            <InputText @bind-Value="_editModel.NHISNumber" class="@FieldClass" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">Date of birth</span>
                            <InputDate @bind-Value="_editModel.DateOfBirth" class="@FieldClass" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">Contact info</span>
                            <InputText @bind-Value="_editModel.ContactInfo" class="@FieldClass" />
                        </label>
                        <label class="text-xs">
                            <span class="text-slate-500">Blood type</span>
                            <InputSelect @bind-Value="_editModel.BloodType" class="@FieldClass">
                                <option value="">Unknown</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </InputSelect>
                        </label>

                        @if (_editError is not null)
                        {
                            <p class="text-xs text-red-600 sm:col-span-2">@_editError</p>
                        }

                        <button type="submit" disabled="@_editBusy"
                                class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                            Save changes
                        </button>
                    </EditForm>
                </Modal>

                <div class="mt-4 inline-flex gap-1 rounded-md border border-slate-200 bg-slate-50 p-1">
                    <button @onclick='() => _activeTab = "visits"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "visits" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Visits</button>
                    <button @onclick='() => _activeTab = "appointments"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "appointments" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Appointments</button>
                    <button @onclick='() => _activeTab = "referrals"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "referrals" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Referrals</button>
                </div>

                @if (_activeTab == "visits")
                {
                    <div class="mt-4">
                        <ListCard TItem="VisitDto" Items="_visits" EmptyText="No visits on record.">
                            <RowTemplate Context="v">
                                <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                                    <span class="text-xs text-slate-500 sm:w-28">@v.Date.ToString("d MMM yyyy")</span>
                                    <span class="text-sm text-slate-700 sm:w-40">@v.FacilityName</span>
                                    <span class="text-sm font-medium text-slate-900">@v.Diagnosis</span>
                                </div>
                            </RowTemplate>
                            <FooterContent>
                                <EditForm Model="_newVisit" OnValidSubmit="HandleLogVisitAsync" class="p-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <InputSelect @bind-Value="_newVisit.FacilityId" class="@FieldClass">
                                        @foreach (var f in _facilities)
                                        {
                                            <option value="@f.FacilityId">@f.Name</option>
                                        }
                                    </InputSelect>
                                    <InputDate @bind-Value="_newVisit.Date" class="@FieldClass" />
                                    <InputText @bind-Value="_newVisit.Diagnosis" placeholder="Diagnosis" class="@FieldClass" />
                                    <InputText @bind-Value="_newVisit.PrescriptionRef" placeholder="Prescription ref (optional)" class="@FieldClass" />
                                    <button type="submit" class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700">Log visit</button>
                                </EditForm>
                            </FooterContent>
                        </ListCard>
                    </div>
                }
                else if (_activeTab == "appointments")
                {
                    <div class="mt-4">
                        <ListCard TItem="AppointmentDto" Items="_appointments" EmptyText="No appointments on record.">
                            <RowTemplate Context="a">
                                <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-2">
                                    <span class="text-xs text-slate-500 sm:w-44 flex-1">@a.ScheduledTime.ToString("d MMM yyyy, h:mm tt")</span>
                                    <span class="text-sm text-slate-700 sm:w-40">@a.FacilityName</span>
                                    <select value="@a.Status" @onchange="@(e => HandleAppointmentStatusChangeAsync(a.AppointmentId, int.Parse((string)e.Value!)))"
                                            class="rounded-md border border-slate-200 px-2 py-1.5 text-xs min-h-[44px]">
                                        <option value="0">Scheduled</option>
                                        <option value="1">Completed</option>
                                        <option value="2">Cancelled</option>
                                        <option value="3">NoShow</option>
                                    </select>
                                </div>
                            </RowTemplate>
                            <FooterContent>
                                <EditForm Model="_newAppointment" OnValidSubmit="HandleScheduleAppointmentAsync" class="p-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <InputSelect @bind-Value="_newAppointment.FacilityId" class="@FieldClass">
                                        @foreach (var f in _facilities)
                                        {
                                            <option value="@f.FacilityId">@f.Name</option>
                                        }
                                    </InputSelect>
                                    <InputDate @bind-Value="_newAppointment.Date" class="@FieldClass" />
                                    <InputText @bind-Value="_newAppointment.Time" placeholder="HH:mm" class="@FieldClass" />
                                    <button type="submit" class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700">Schedule appointment</button>
                                </EditForm>
                            </FooterContent>
                        </ListCard>
                    </div>
                }
                else
                {
                    <div class="mt-4">
                        <ListCard TItem="ReferralDto" Items="_referrals" EmptyText="No referrals on record.">
                            <RowTemplate Context="r">
                                @{ var meta = ReferralStatusMeta(r.Status); }
                                <div class="p-3 flex items-center justify-between gap-2">
                                    <span class="text-sm text-slate-700">@r.FromFacilityName &rarr; @r.ToFacilityName</span>
                                    <span class="rounded-md border px-2 py-0.5 text-xs font-semibold uppercase tracking-wider @meta.Classes">@meta.Label</span>
                                </div>
                            </RowTemplate>
                            <FooterContent>
                                <a href="/referrals" class="block p-3 text-sm font-semibold text-slate-900 hover:bg-slate-50">Create a referral &rarr;</a>
                            </FooterContent>
                        </ListCard>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    [Parameter] public int PatientId { get; set; }

    private PatientDto? _patient;
    private List<VisitDto> _visits = [];
    private List<AppointmentDto> _appointments = [];
    private List<ReferralDto> _referrals = [];
    private List<FacilityDto> _facilities = [];

    private readonly NewVisitModel _newVisit = new();
    private readonly NewAppointmentModel _newAppointment = new();
    private readonly EditPatientModel _editModel = new();
    private string _activeTab = "visits";
    private bool _showEditModal;
    private bool _editBusy;
    private string? _editError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _patient = await PatientsApi.GetByIdAsync(PatientId);
        _facilities = await FacilitiesApi.GetAllAsync();
        if (_facilities.Count > 0)
        {
            _newVisit.FacilityId = _facilities[0].FacilityId;
            _newAppointment.FacilityId = _facilities[0].FacilityId;
        }
        if (_patient is not null)
        {
            _visits = await VisitsApi.GetByPatientAsync(PatientId);
            _appointments = (await AppointmentsApi.GetByPatientAsync(PatientId)).Items;
            _referrals = await ReferralsApi.GetByPatientAsync(PatientId);
        }
    }

    private async Task HandleLogVisitAsync()
    {
        var result = await VisitsApi.CreateAsync(new CreateVisitDto(
            PatientId, _newVisit.FacilityId, _newVisit.Date, _newVisit.Diagnosis,
            string.IsNullOrWhiteSpace(_newVisit.PrescriptionRef) ? null : _newVisit.PrescriptionRef));

        if (result.Succeeded)
        {
            _visits.Insert(0, result.Value!);
            _newVisit.Diagnosis = "";
            _newVisit.PrescriptionRef = "";
        }
    }

    private async Task HandleScheduleAppointmentAsync()
    {
        if (!TimeOnly.TryParse(_newAppointment.Time, out var time))
        {
            return;
        }

        var scheduledTime = _newAppointment.Date.ToDateTime(time);
        var result = await AppointmentsApi.CreateAsync(new CreateAppointmentDto(PatientId, _newAppointment.FacilityId, scheduledTime));

        if (result.Succeeded)
        {
            _appointments.Insert(0, result.Value!);
        }
    }

    private async Task HandleAppointmentStatusChangeAsync(int appointmentId, int status)
    {
        await AppointmentsApi.UpdateStatusAsync(appointmentId, status);
    }

    private void OpenEditModal()
    {
        if (_patient is null)
        {
            return;
        }

        _editModel.FullName = _patient.FullName;
        _editModel.NHISNumber = _patient.NHISNumber;
        _editModel.DateOfBirth = _patient.DateOfBirth.ToDateTime(TimeOnly.MinValue);
        _editModel.ContactInfo = _patient.ContactInfo;
        _editModel.BloodType = _patient.BloodType ?? "";
        _editError = null;
        _showEditModal = true;
    }

    private async Task HandleEditAsync()
    {
        _editBusy = true;
        _editError = null;

        var result = await PatientsApi.UpdateAsync(PatientId, new CreatePatientDto(
            _editModel.NHISNumber, _editModel.FullName,
            DateOnly.FromDateTime(_editModel.DateOfBirth), _editModel.ContactInfo,
            string.IsNullOrEmpty(_editModel.BloodType) ? null : _editModel.BloodType));

        if (result.Succeeded)
        {
            _patient = result.Value;
            _showEditModal = false;
        }
        else
        {
            _editError = result.Error;
        }

        _editBusy = false;
    }

    private static (string Label, string Classes) ReferralStatusMeta(int status) => status switch
    {
        1 => ("Accepted", "bg-blue-50 text-blue-700 border-blue-200"),
        2 => ("In transit", "bg-blue-50 text-blue-700 border-blue-200"),
        3 => ("Completed", "bg-emerald-50 text-emerald-700 border-emerald-200"),
        4 => ("Cancelled", "bg-slate-100 text-slate-500 border-slate-200"),
        _ => ("Pending", "bg-amber-50 text-amber-700 border-amber-200"),
    };

    private class NewVisitModel
    {
        public int FacilityId { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string Diagnosis { get; set; } = "";
        public string? PrescriptionRef { get; set; }
    }

    private class NewAppointmentModel
    {
        public int FacilityId { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string Time { get; set; } = "09:00";
    }

    private class EditPatientModel
    {
        public string FullName { get; set; } = "";
        public string NHISNumber { get; set; } = "";
        public DateTime DateOfBirth { get; set; } = DateTime.Today;
        public string ContactInfo { get; set; } = "";
        public string BloodType { get; set; } = "";
    }
}
