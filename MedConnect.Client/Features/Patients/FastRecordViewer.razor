@page "/spotlight"
@using MedConnect.Client.Features.Patients
@using MedConnect.Client.Features.Vitals
@using MedConnect.Client.Shared
@using System.Text.Json
@inject PatientsApiClient PatientsApi
@inject VitalsApiClient VitalsApi
@inject IJSRuntime JS

<PageTitle>Quick Lookup - MedConnect GH</PageTitle>

<AuthorizeView Roles="CHW,Doctor,Nurse,FacilityAdmin,Admin" Context="_">
    <Authorized>
        <div class="max-w-4xl">
            <div class="lg:flex lg:items-start lg:gap-4">
                <div class="lg:w-80 lg:shrink-0">
                    <div class="relative">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z" />
                        </svg>
                        <input type="text"
                               placeholder="Search patients by name or NHIS..."
                               class="w-full min-h-[44px] rounded-md border border-slate-300 bg-white pl-8 pr-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                               @bind-value="_searchQuery"
                               @bind-value:event="oninput"
                               @onkeyup="OnSearchInput" />
                    </div>

                    @if (_isSearching)
                    {
                        <p class="mt-2 text-sm text-slate-500">Searching records...</p>
                    }
                    else if (_searchResults.Any())
                    {
                        <div class="mt-2 rounded-md border border-slate-200 bg-white divide-y divide-slate-100">
                            @foreach (var patient in _searchResults)
                            {
                                var isSelected = patient.PatientId == _selectedPatient?.PatientId;
                                <button @onclick="() => SelectPatient(patient)"
                                        class="flex w-full items-center justify-between gap-2 px-3 py-2.5 text-left hover:bg-slate-50 @(isSelected ? "bg-slate-100" : "")">
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium text-slate-900 truncate">@patient.FullName</p>
                                        <p class="text-xs text-slate-500">NHIS: @patient.NHISNumber</p>
                                    </div>
                                    <span class="shrink-0 text-xs text-slate-400">Select &rarr;</span>
                                </button>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <p class="mt-2 text-sm text-slate-500">No patient found matching "@_searchQuery"</p>
                    }
                </div>

                @if (_selectedPatient != null)
                {
                    <div class="mt-4 lg:mt-0 flex-1 rounded-md border border-slate-200 bg-white">
                        <div class="flex items-start justify-between gap-3 p-4">
                            <div>
                                <h2 class="text-lg font-semibold tracking-tight text-slate-900">@_selectedPatient.FullName</h2>
                                <p class="text-sm text-slate-500 mt-0.5">NHIS @_selectedPatient.NHISNumber &middot; DOB @_selectedPatient.DateOfBirth.ToString("d MMM yyyy")</p>
                            </div>
                            <span class="shrink-0 rounded-md border px-2 py-0.5 text-xs font-semibold uppercase tracking-wider @(_isOfflineCached ? "bg-amber-50 text-amber-700 border-amber-200" : "bg-emerald-50 text-emerald-700 border-emerald-200")">
                                @(_isOfflineCached ? "Cached (offline)" : "Live record")
                            </span>
                        </div>

                        <div class="mx-4 mt-3 inline-flex gap-1 rounded-md border border-slate-200 bg-slate-50 p-1">
                            <button @onclick='() => _activeTab = "vitals"'
                                    class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "vitals" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Vitals</button>
                            <button @onclick='() => _activeTab = "visits"'
                                    class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "visits" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Visit History</button>
                            <button @onclick='() => _activeTab = "prescriptions"'
                                    class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "prescriptions" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Prescriptions</button>
                        </div>

                        <div class="p-4">
                            @if (_activeTab == "vitals")
                            {
                                @if (_latestVital is null)
                                {
                                    <p class="text-sm text-slate-500">No vitals recorded for this patient yet.</p>
                                }
                                else
                                {
                                    var meta = VitalAlertMeta(_latestVital.AlertLevel);
                                    <div class="grid grid-cols-3 gap-3">
                                        <div class="rounded-md bg-slate-50 border border-slate-100 p-3">
                                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Blood pressure</p>
                                            <p class="mt-1 text-lg font-semibold tabular-nums text-slate-900">@_latestVital.BloodPressureSystolic / @_latestVital.BloodPressureDiastolic</p>
                                            <p class="mt-0.5 text-xs font-medium @meta.Classes">@meta.Label</p>
                                        </div>
                                        <div class="rounded-md bg-slate-50 border border-slate-100 p-3">
                                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Heart rate</p>
                                            <p class="mt-1 text-lg font-semibold tabular-nums text-slate-900">@_latestVital.HeartRate bpm</p>
                                            <p class="mt-0.5 text-xs font-medium @meta.Classes">@meta.Label</p>
                                        </div>
                                        <div class="rounded-md bg-slate-50 border border-slate-100 p-3">
                                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">SpO2</p>
                                            <p class="mt-1 text-lg font-semibold tabular-nums text-slate-900">@(_latestVital.OxygenSaturation?.ToString() ?? "—")%</p>
                                            <p class="mt-0.5 text-xs font-medium @meta.Classes">@meta.Label</p>
                                        </div>
                                    </div>
                                    <p class="mt-3 text-xs text-slate-500">Recorded by @_latestVital.RecordedByName &middot; @_latestVital.RecordedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p>
                                }
                            }
                            else if (_activeTab == "visits")
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-slate-900 font-medium">General Checkup</span>
                                    <span class="text-slate-500">14 Aug 2026</span>
                                </div>
                            }
                            else if (_activeTab == "prescriptions")
                            {
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm text-slate-700">Amoxicillin 500mg &mdash; 1 capsule, 3&times; daily, 7 days</span>
                                    <span class="shrink-0 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-emerald-700">Active</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _searchQuery = "";
    private bool _isSearching = false;
    private List<PatientDto> _allPatients = [];
    private List<PatientDto> _searchResults = [];
    private PatientDto? _selectedPatient;
    private VitalSignDto? _latestVital;
    private string _activeTab = "vitals";
    private bool _isOfflineCached = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allPatients = await PatientsApi.GetAllAsync();
        }
        catch
        {
            var cachedJson = await JS.InvokeAsync<string>("localStorage.getItem", "mc_patients_cache");
            if (!string.IsNullOrEmpty(cachedJson))
            {
                _allPatients = JsonSerializer.Deserialize<List<PatientDto>>(cachedJson) ?? [];
                _isOfflineCached = true;
            }
        }
    }

    private async Task OnSearchInput()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults.Clear();
            return;
        }

        _isSearching = true;
        await Task.Delay(150);

        _searchResults = _allPatients
            .Where(p => p.FullName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        p.NHISNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .ToList();

        _isSearching = false;
    }

    private async Task SelectPatient(PatientDto patient)
    {
        _selectedPatient = patient;
        _searchResults.Clear();
        _searchQuery = "";
        _latestVital = null;

        await JS.InvokeVoidAsync("localStorage.setItem", $"mc_patient_{patient.PatientId}", JsonSerializer.Serialize(patient));
        await JS.InvokeVoidAsync("localStorage.setItem", "mc_patients_cache", JsonSerializer.Serialize(_allPatients));
        _isOfflineCached = false;

        var vitals = await VitalsApi.GetByPatientAsync(patient.PatientId);
        _latestVital = vitals.OrderByDescending(v => v.RecordedAt).FirstOrDefault();
    }

    private static (string Label, string Classes) VitalAlertMeta(int level) => level switch
    {
        2 => ("Critical", "text-red-600"),
        1 => ("Warning", "text-amber-600"),
        _ => ("Normal", "text-emerald-600"),
    };
}
