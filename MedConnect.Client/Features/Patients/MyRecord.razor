@page "/my-record"
@using MedConnect.Client.Features.Appointments
@using MedConnect.Client.Features.Referrals
@using MedConnect.Client.Features.Visits
@using MedConnect.Client.Shared
@inject PatientsApiClient PatientsApi
@inject VisitsApiClient VisitsApi
@inject ReferralsApiClient ReferralsApi
@inject AppointmentsApiClient AppointmentsApi

<PageTitle>My Record - MedConnect GH</PageTitle>

<AuthorizeView Roles="Patient">
    <Authorized>
        @if (_patient is null)
        {
            <p class="text-sm text-slate-500">Loading your record...</p>
        }
        else
        {
            <div class="max-w-3xl">
                <h1 class="text-xl font-semibold tracking-tight text-slate-900">@_patient.FullName</h1>
                <p class="mt-1 text-sm text-slate-500">NHIS @_patient.NHISNumber &middot; DOB @_patient.DateOfBirth.ToString("d MMM yyyy") &middot; @_patient.ContactInfo</p>

                <div class="mt-4 rounded-md border border-slate-200 bg-white p-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <h2 class="text-sm font-semibold text-slate-900">Data-sharing consent</h2>
                            <p class="mt-1 text-xs text-slate-500">Allow health facilities to share this record so care is coordinated across the system.</p>
                            @if (_consentUpdatedAt is not null)
                            {
                                <p class="mt-1 text-xs @(_consent == true ? "text-emerald-600" : "text-amber-600")">
                                    @(_consent == true ? "Consent active" : "Consent withdrawn") &middot; last updated @_consentUpdatedAt.Value.ToLocalTime().ToString("d MMM yyyy, h:mm tt")
                                </p>
                            }
                            @if (_consentError is not null)
                            {
                                <p class="mt-1 text-xs text-red-600">@_consentError</p>
                            }
                        </div>
                        <div class="inline-flex gap-1">
                            <button disabled="@_savingConsent" @onclick='() => SaveConsent(true)'
                                    class="rounded-md border px-3 py-1.5 text-sm font-medium @(_consent == true ? "bg-emerald-600 text-white border-emerald-600" : "bg-white text-slate-600 hover:bg-emerald-50")">
                                Grant
                            </button>
                            <button disabled="@_savingConsent" @onclick='() => SaveConsent(false)'
                                    class="rounded-md border px-3 py-1.5 text-sm font-medium @(_consent == false ? "bg-slate-200 text-slate-700 border-slate-300" : "bg-white text-slate-600 hover:bg-slate-100")">
                                Withdraw
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4 inline-flex gap-1 rounded-md border border-slate-200 bg-slate-50 p-1">
                    <button @onclick='() => _activeTab = "visits"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "visits" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Visits</button>
                    <button @onclick='() => _activeTab = "appointments"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "appointments" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Appointments</button>
                    <button @onclick='() => _activeTab = "referrals"'
                            class="rounded-md px-3 py-1.5 text-sm font-medium @(_activeTab == "referrals" ? "bg-blue-600 text-white" : "text-slate-500 hover:text-slate-700")">Referrals</button>
                </div>

                <div class="mt-4">
                    @if (_activeTab == "visits")
                    {
                        <ListCard TItem="VisitDto" Items="_visits" EmptyText="No visits on record yet.">
                            <RowTemplate Context="v">
                                <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                                    <span class="text-xs text-slate-500 sm:w-28">@v.Date.ToString("d MMM yyyy")</span>
                                    <span class="text-sm text-slate-700 sm:w-40">@v.FacilityName</span>
                                    <span class="text-sm font-medium text-slate-900">@v.Diagnosis</span>
                                </div>
                            </RowTemplate>
                        </ListCard>
                    }
                    else if (_activeTab == "appointments")
                    {
                        <ListCard TItem="AppointmentDto" Items="_appointments" EmptyText="No appointments on record yet.">
                            <RowTemplate Context="a">
                                @{ var meta = AppointmentStatusMeta(a.Status); }
                                <div class="p-3 flex items-center justify-between gap-2">
                                    <span class="text-sm text-slate-700">@a.ScheduledTime.ToString("d MMM yyyy, h:mm tt") &middot; @a.FacilityName</span>
                                    <span class="rounded-md border px-2 py-0.5 text-xs font-semibold uppercase tracking-wider @meta.Classes">@meta.Label</span>
                                </div>
                            </RowTemplate>
                        </ListCard>
                    }
                    else
                    {
                        <ListCard TItem="ReferralDto" Items="_referrals" EmptyText="No referrals on record yet.">
                            <RowTemplate Context="r">
                                @{ var meta = ReferralStatusMeta(r.Status); }
                                <div class="p-3 flex items-center justify-between gap-2">
                                    <span class="text-sm text-slate-700">@r.FromFacilityName &rarr; @r.ToFacilityName</span>
                                    <span class="rounded-md border px-2 py-0.5 text-xs font-semibold uppercase tracking-wider @meta.Classes">@meta.Label</span>
                                </div>
                            </RowTemplate>
                        </ListCard>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private PatientDto? _patient;
    private List<VisitDto> _visits = [];
    private List<ReferralDto> _referrals = [];
    private List<AppointmentDto> _appointments = [];
    private string _activeTab = "visits";
    private bool? _consent;
    private DateTimeOffset? _consentUpdatedAt;
    private bool _savingConsent;
    private string? _consentError;

    protected override async Task OnInitializedAsync()
    {
        _patient = await PatientsApi.GetMineAsync();
        if (_patient is not null)
        {
            _visits = await VisitsApi.GetByPatientAsync(_patient.PatientId);
            _referrals = await ReferralsApi.GetByPatientAsync(_patient.PatientId);
            _appointments = (await AppointmentsApi.GetByPatientAsync(_patient.PatientId)).Items;
            var consent = await PatientsApi.GetConsentAsync(_patient.PatientId);
            if (consent is not null)
            {
                _consent = consent.Consent;
                _consentUpdatedAt = consent.UpdatedAt;
            }
        }
    }

    private async Task SaveConsent(bool grant)
    {
        if (_patient is null || _savingConsent)
        {
            return;
        }

        _savingConsent = true;
        _consentError = null;
        var result = await PatientsApi.SetConsentAsync(_patient.PatientId, grant);
        if (result.Succeeded)
        {
            _consent = result.Value?.Consent;
            _consentUpdatedAt = result.Value?.UpdatedAt;
        }
        else
        {
            _consentError = result.Error;
        }

        _savingConsent = false;
    }

    private static (string Label, string Classes) ReferralStatusMeta(int status) => status switch
    {
        1 => ("Accepted", "bg-blue-50 text-blue-700 border-blue-200"),
        2 => ("In transit", "bg-blue-50 text-blue-700 border-blue-200"),
        3 => ("Completed", "bg-emerald-50 text-emerald-700 border-emerald-200"),
        4 => ("Cancelled", "bg-slate-100 text-slate-500 border-slate-200"),
        _ => ("Pending", "bg-amber-50 text-amber-700 border-amber-200"),
    };

    private static (string Label, string Classes) AppointmentStatusMeta(int status) => status switch
    {
        1 => ("Completed", "bg-emerald-50 text-emerald-700 border-emerald-200"),
        2 => ("Cancelled", "bg-slate-100 text-slate-500 border-slate-200"),
        3 => ("No show", "bg-red-50 text-red-700 border-red-200"),
        _ => ("Scheduled", "bg-amber-50 text-amber-700 border-amber-200"),
    };
}
