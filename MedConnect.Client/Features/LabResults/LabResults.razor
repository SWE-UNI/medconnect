@page "/lab-results"
@using MedConnect.Client.Shared
@inject LabResultsApiClient LabsApi
@inject CustomAuthStateProvider AuthStateProvider

<PageTitle>Lab Results - MedConnect GH</PageTitle>

<AuthorizeView Roles="CHW,Doctor,Nurse,FacilityAdmin,Admin" Context="_">
    <Authorized>
        <div class="max-w-3xl">
            <div class="rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Order a lab test</p>
                <EditForm Model="_order" OnValidSubmit="HandleOrderAsync" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <label class="text-xs">
                        <span class="text-slate-500">Patient ID</span>
                        <InputNumber id="orderPatientId" @bind-Value="_order.PatientId" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Facility ID</span>
                        <InputNumber id="orderFacilityId" @bind-Value="_order.FacilityId" class="@FieldClass" />
                    </label>
                    <label class="text-xs sm:col-span-2">
                        <span class="text-slate-500">Test name</span>
                        <InputText id="testName" @bind-Value="_order.TestName" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Unit (optional)</span>
                        <InputText id="unit" @bind-Value="_order.Unit" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Reference range (optional)</span>
                        <InputText id="referenceRange" @bind-Value="_order.ReferenceRange" class="@FieldClass" />
                    </label>

                    @if (_error is not null)
                    {
                        <p class="text-xs text-red-600 sm:col-span-2">@_error</p>
                    }

                    <button type="submit" disabled="@_busy"
                            class="sm:col-span-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Order test
                    </button>
                </EditForm>
            </div>

            <div class="mt-4 rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Patient results</p>
                <div class="mt-3 flex items-end gap-3">
                    <label class="text-xs flex-1">
                        <span class="text-slate-500">Patient ID</span>
                        <InputNumber id="searchPatientId" @bind-Value="_searchPatientId" class="@FieldClass" />
                    </label>
                    <button type="button" @onclick="LoadAsync" disabled="@_busy"
                            class="min-h-[44px] rounded-md bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
                        Load
                    </button>
                </div>

                @if (_loaded && _totalCount == 0)
                {
                    <p class="mt-4 text-sm text-slate-500">No results for this patient yet.</p>
                }

                <div class="mt-3 flex flex-col gap-2">
                    @foreach (var r in _results)
                    {
                        <div class="rounded-md border border-slate-200 p-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-slate-900">@r.TestName</span>
                                    <span class="text-[10px] rounded-md px-1.5 py-0.5 font-semibold @StatusBadge(r.Status)">@r.Status</span>
                                </div>
                                <span class="text-xs text-slate-500">@r.OrderedAt.ToString("d MMM yyyy") · @r.OrderedByUserName</span>
                            </div>

                            @if (r.Status == "Ordered")
                            {
                                <textarea @bind="_completeTexts[r.LabResultId]" rows="2" class="@TextAreaClass mt-2" placeholder="Enter result text..."></textarea>
                                <button type="button" @onclick="() => CompleteAsync(r.LabResultId)" disabled="@_busy"
                                        class="mt-2 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                                    Mark complete
                                </button>
                            }
                            else
                            {
                                <p class="mt-2 text-sm text-slate-700">@r.ResultText</p>
                                @if (!string.IsNullOrEmpty(r.ReferenceRange))
                                {
                                    <p class="mt-1 text-xs text-slate-500">Reference: @r.ReferenceRange</p>
                                }
                                @if (!string.IsNullOrEmpty(r.ReviewedByUserName))
                                {
                                    <p class="mt-1 text-xs text-slate-500">Completed by @r.ReviewedByUserName on @(r.CompletedAt?.ToString("d MMM yyyy"))</p>
                                }
                            }
                        </div>
                    }
                </div>

                <Pager CurrentPage="_page" TotalPages="_totalPages" OnPageChanged="HandlePageChangeAsync" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private const string TextAreaClass =
        "mt-1 w-full min-h-[72px] rounded-md border border-slate-300 px-2.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private readonly OrderModel _order = new();
    private readonly Dictionary<int, string> _completeTexts = new();
    private int? _searchPatientId;
    private List<LabResultDto> _results = [];
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalPages;
    private int _totalCount;
    private bool _loaded;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var facilityId = state.User.FindFirst("FacilityId")?.Value;
        if (int.TryParse(facilityId, out var id) && id > 0)
        {
            _order.FacilityId = id;
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _loaded = false;
        if (_searchPatientId.HasValue)
        {
            var page = await LabsApi.GetByPatientAsync(_searchPatientId.Value, _page, _pageSize);
            _results = page.Items;
            _totalPages = page.TotalPages;
            _totalCount = page.TotalCount;
        }
        else
        {
            _results = [];
            _totalPages = 0;
            _totalCount = 0;
        }
        _loaded = true;
        _busy = false;
    }

    private async Task HandlePageChangeAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task HandleOrderAsync()
    {
        _busy = true;
        _error = null;

        if (string.IsNullOrWhiteSpace(_order.TestName))
        {
            _error = "Test name is required.";
            _busy = false;
            return;
        }

        var result = await LabsApi.CreateAsync(new CreateLabResultDto(
            _order.PatientId, _order.FacilityId, _order.TestName, _order.Unit, _order.ReferenceRange));

        if (result.Succeeded)
        {
            _order.TestName = "";
            _order.Unit = null;
            _order.ReferenceRange = null;
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private async Task CompleteAsync(int id)
    {
        _busy = true;
        _error = null;

        var text = _completeTexts.GetValueOrDefault(id) ?? "";
        if (string.IsNullOrWhiteSpace(text))
        {
            _error = "Enter a result text before marking complete.";
            _busy = false;
            return;
        }

        var result = await LabsApi.CompleteAsync(id, new CompleteLabResultDto(text));
        if (!result.Succeeded)
        {
            _error = result.Error;
        }

        _busy = false;
        await LoadAsync();
    }

    private static string StatusBadge(string status) =>
        status == "Completed" ? "bg-green-50 text-green-700 border border-green-200"
        : status == "Cancelled" ? "bg-slate-50 text-slate-600 border border-slate-200"
        : "bg-amber-50 text-amber-700 border border-amber-200";

    private class OrderModel
    {
        public int PatientId { get; set; }
        public int FacilityId { get; set; }
        public string TestName { get; set; } = "";
        public string? Unit { get; set; }
        public string? ReferenceRange { get; set; }
    }
}