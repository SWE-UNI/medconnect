@page "/facilities"
@using MedConnect.Client.Shared
@inject FacilitiesApiClient FacilitiesApi
@inject IJSRuntime JS

<PageTitle>Facilities - MedConnect GH</PageTitle>

<AuthorizeView Roles="Admin" Context="_">
    <Authorized>
        <div class="max-w-3xl">
            <div class="flex items-center justify-end gap-3">
                <button @onclick="() => _showCreateModal = true"
                        class="shrink-0 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700">
                    + New facility
                </button>
            </div>

            <Modal Title="Add a facility" @bind-Show="_showCreateModal">
                <EditForm Model="_newFacility" OnValidSubmit="HandleCreateAsync" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <label class="text-xs">
                        <span class="text-slate-500">Name</span>
                        <InputText id="name" @bind-Value="_newFacility.Name" class="@FieldClass" />
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Type</span>
                        <InputSelect id="type" @bind-Value="_newFacility.Type" class="@FieldClass">
                            <option value="0">CHPS</option>
                            <option value="1">Clinic</option>
                            <option value="2">Hospital</option>
                        </InputSelect>
                    </label>
                    <label class="text-xs">
                        <span class="text-slate-500">Location</span>
                        <InputText id="location" @bind-Value="_newFacility.Location" class="@FieldClass" />
                    </label>

                    @if (_error is not null)
                    {
                        <p class="text-xs text-red-600 sm:col-span-3">@_error</p>
                    }

                    <button type="submit" disabled="@_busy"
                            class="sm:col-span-3 min-h-[44px] rounded-md bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        Add facility
                    </button>
                </EditForm>
            </Modal>

            @if (_deleteError is not null)
            {
                <p class="mt-3 text-xs text-red-600">@_deleteError</p>
            }

            <div class="mt-4">
                <ListCard TItem="FacilityDto" Title="All facilities" Items="_facilities" EmptyText="No facilities yet.">
                    <RowTemplate Context="f">
                        <div class="p-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                            <span class="text-sm font-medium text-slate-900 sm:w-48">@f.Name</span>
                            <span class="text-sm text-slate-700 sm:w-24">@FacilityTypeName(f.Type)</span>
                            <span class="flex-1 text-sm text-slate-500">@f.Location</span>
                            <button @onclick="() => HandleDeleteAsync(f)" title="Delete facility"
                                    class="shrink-0 min-h-[44px] rounded-md border border-slate-200 px-3 text-xs font-semibold text-red-600 hover:border-red-200 hover:bg-red-50">
                                Delete
                            </button>
                        </div>
                    </RowTemplate>
                </ListCard>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string FieldClass =
        "mt-1 w-full min-h-[44px] rounded-md border border-slate-300 px-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30";

    private List<FacilityDto> _facilities = [];
    private readonly NewFacilityModel _newFacility = new();
    private string? _error;
    private string? _deleteError;
    private bool _busy;
    private bool _showCreateModal;

    protected override async Task OnInitializedAsync()
    {
        _facilities = await FacilitiesApi.GetAllAsync();
    }

    private async Task HandleCreateAsync()
    {
        _busy = true;
        _error = null;

        var result = await FacilitiesApi.CreateAsync(new CreateFacilityDto(
            _newFacility.Name, _newFacility.Type, _newFacility.Location));

        if (result.Succeeded)
        {
            _facilities.Add(result.Value!);
            _newFacility.Name = "";
            _newFacility.Location = "";
            _showCreateModal = false;
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private async Task HandleDeleteAsync(FacilityDto facility)
    {
        _deleteError = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {facility.Name}? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        var result = await FacilitiesApi.DeleteAsync(facility.FacilityId);
        if (result.Succeeded)
        {
            _facilities.Remove(facility);
        }
        else
        {
            _deleteError = result.Error;
        }
    }

    private static string FacilityTypeName(int type) => type switch
    {
        0 => "CHPS",
        1 => "Clinic",
        2 => "Hospital",
        _ => "Unknown"
    };

    private class NewFacilityModel
    {
        public string Name { get; set; } = "";
        public int Type { get; set; }
        public string Location { get; set; } = "";
    }
}
